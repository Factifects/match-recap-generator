# Copy to .env and fill in. .env is gitignored — never commit real keys.
API_FOOTBALL_KEY=
ELEVENLABS_API_KEY=

# --- Script authoring (npm run author) -------------------------------------
# Which model writes scripts: gemini | groq | cerebras | openrouter | mistral | ollama | anthropic
# Everything except "anthropic" is a free tier.
# Gemini is the default deliberately: the repair loop in src/ai/ is what makes
# a script valid, not the model, so the expensive option should be an explicit
# choice for a video that matters rather than the silent default an unattended
# queue runs on.
LLM_PROVIDER=gemini

# Google AI Studio (aistudio.google.com/apikey).
# WARNING: the free tier is only 20 requests/DAY per model (quotaId
# GenerateRequestsPerDayPerProjectPerModel-FreeTier). One 6-scene script uses
# 8-15 requests, so this is about one script per model per day. The quota is
# per model, so changing GEMINI_MODEL gives a fresh allowance. For real use,
# prefer groq/cerebras/openrouter (far larger free tiers) or local ollama.
GEMINI_API_KEY=
# Optional override. Google retires model names periodically and the 404 body
# names the replacement, which the provider passes through verbatim.
GEMINI_MODEL=gemini-3.6-flash

# Only needed when running with --llm anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Other free providers (all OpenAI-compatible; pick any ONE) -------------
# Set LLM_PROVIDER to the one you want, and its key below. LLM_MODEL overrides
# that provider's default model when the vendor renames things.
# LLM_MODEL=

# console.groq.com/keys — free, very fast
GROQ_API_KEY=
# cloud.cerebras.ai — free, strong coding models
CEREBRAS_API_KEY=
# openrouter.ai/keys — free models carry a `:free` suffix
OPENROUTER_API_KEY=
# console.mistral.ai — free tier
MISTRAL_API_KEY=
# Ollama needs no key at all: install it, `ollama pull qwen2.5-coder:14b`,
# then LLM_PROVIDER=ollama. Fully local, no quota, no network.

# Critique needs a model that can SEE. When LLM_PROVIDER is text-only (groq),
# the critique pass automatically falls back to this one — the recommended
# everyday pairing is LLM_PROVIDER=groq (no daily cap) with gemini for vision.
VISION_PROVIDER=gemini
# VISION_MODEL=
